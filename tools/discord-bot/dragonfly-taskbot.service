# systemd unit for running the bot on a Linux VM.
# Copy to /etc/systemd/system/, then: sudo systemctl enable --now dragonfly-taskbot
[Unit]
Description=Dragonfly Discord task bot
After=network-online.target
Wants=network-online.target

[Service]
User=taskbot
WorkingDirectory=/opt/dragonfly/tools/discord-bot
# .env in WorkingDirectory holds the settings; keep it chmod 600
ExecStart=/opt/dragonfly/tools/discord-bot/.venv/bin/python -m taskbot
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
