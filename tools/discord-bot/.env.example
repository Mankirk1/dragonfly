# Copy to .env (git-ignored) and fill in. Never commit the real file.

# Discord bot token. On the Google Cloud VM, keep it in Secret Manager and give its
# name here; the bot reads it at start-up, so the token is never stored on the VM.
TASKBOT_DISCORD_TOKEN_SECRET=projects/YOUR_PROJECT_ID/secrets/discord-token/versions/latest
# Only for running on your own computer: the token itself. Leave empty on the VM.
TASKBOT_DISCORD_TOKEN=
# Right-click the server / channel in Discord (Developer Mode on) > Copy ID
TASKBOT_GUILD_ID=
TASKBOT_CHANNEL_ID=

# Google: the Sheet's ID or full link. The "Radar Detection Timeline" Sheet in
# Proposal Documents. On the Google Cloud VM the bot signs in to Google as the VM's
# service account, so no key file is needed.
TASKBOT_SHEET_ID=
# Only if you can't run on Google Cloud and your account allows keys (not recommended):
# TASKBOT_GOOGLE_CREDENTIALS_FILE=./secrets/service-account.json

# The first day of week 1. Leave empty to read it from the WEEKLY CHECK-IN tab (W01).
TASKBOT_PROJECT_START=
TASKBOT_TIMEZONE=Europe/Paris
# The plan's weeks run Saturday to Friday, so the weekly post goes out on Saturday.
TASKBOT_WEEKLY_DAY=sat
TASKBOT_WEEKLY_TIME=10:00
# Mid-week DM reminder of what's still open (off to turn it off)
TASKBOT_REMINDER_DAY=wed
# How to read dates like 03/04/2027: dmy (3 April) or mdy (March 4)
TASKBOT_DATE_ORDER=dmy

# Tabs. TASKS_TAB empty means the first tab that looks like a task list (TASK BOARD).
TASKBOT_TASKS_TAB=
# Created by the bot: plan names and Discord IDs
TASKBOT_TEAM_TAB=TEAM
# Every sign-off and status change adds a row here
TASKBOT_LOG_TAB=WORK LOG
TASKBOT_CHECKIN_TAB=WEEKLY CHECK-IN
TASKBOT_MILESTONES_TAB=MILESTONES

# Column headers in the plan. Leave empty to detect them from common names.
TASKBOT_COL_WEEK=
TASKBOT_COL_START=
TASKBOT_COL_FINISH=
TASKBOT_COL_TASK=
TASKBOT_COL_ASSIGNEE=
TASKBOT_COL_STATUS=
TASKBOT_COL_DUE=
TASKBOT_COL_ID=
TASKBOT_COL_SIGNED_OFF_BY=
TASKBOT_COL_SIGNED_OFF_AT=
TASKBOT_COL_LAST_UPDATED=
TASKBOT_COL_PROGRESS=
# Who counts as an admin besides people with Manage Server: a role name or role ID.
# Admins can change any task, re-link names and run /plan.
TASKBOT_ADMIN_ROLE=
# Who gets a DM if the Sheet can't be reached for 30 minutes (a Discord user ID).
# Empty: the Discord app's owner.
TASKBOT_ALERT_USER_ID=
# Post a heads-up this many days before each milestone (0 turns it off)
TASKBOT_GATE_NOTICE_DAYS=2
# Log what the bot would write instead of writing it. Turn this on for a first test run.
TASKBOT_READ_ONLY=false
# Add ID / Owner(s) / Status / Completion date columns if missing (the TASK BOARD has them)
TASKBOT_AUTO_ADD_COLUMNS=true
# The Status dropdown's options, and which one means finished
TASKBOT_STATUS_VALUES=Not started,In progress,Blocked,Postponed,Done,Cancelled
TASKBOT_DONE_LABEL=Done
